{
	"name": "return-visits-push",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --test-scheduled",
		"deploy": "wrangler deploy",
		"db:migrate": "wrangler d1 execute return-visits-push --remote --file=schema.sql",
		"db:migrate:local": "wrangler d1 execute return-visits-push --local --file=schema.sql",
		"vapid": "node scripts/generate-vapid-keys.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@block65/webcrypto-web-push": "2.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260930.2",
		"typescript": "5.7.3",
		"wrangler": "4.145.0"
	}
}
